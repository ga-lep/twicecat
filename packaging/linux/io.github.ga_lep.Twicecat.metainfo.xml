<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata: what software centres (GNOME Software, KDE Discover,
     the Steam Frame's desktop mode) show for Twicecat. The id is the app ID
     the desktop entry, the window and the shortcuts portal use. -->
<component type="desktop-application">
  <id>io.github.ga_lep.Twicecat</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Twicecat</name>
  <summary>Encrypted chat and voice calls on Matrix</summary>
  <developer id="io.github.ga_lep">
    <name>The Twicecat developers</name>
  </developer>

  <description>
    <p>
      Twicecat is a native desktop client for Matrix, written in Rust. It talks
      to anyone on Matrix, including Element users, with end-to-end encryption.
    </p>
    <ul>
      <li>Encrypted rooms and direct messages, with device verification and key recovery</li>
      <li>Voice calls compatible with Element Call, with echo cancellation and noise suppression on the CPU or the GPU</li>
      <li>Push-to-talk on a global key or a gamepad button, also on Wayland</li>
      <li>Images, files, threads, reactions, notifications and a tray icon</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.ga_lep.Twicecat.desktop</launchable>
  <provides>
    <binary>twicecat</binary>
  </provides>

  <url type="homepage">https://github.com/ga-lep/twicecat</url>
  <url type="bugtracker">https://github.com/ga-lep/twicecat/issues</url>
  <url type="vcs-browser">https://github.com/ga-lep/twicecat</url>

  <categories>
    <category>Network</category>
    <category>InstantMessaging</category>
    <category>Chat</category>
  </categories>
  <keywords>
    <keyword>Matrix</keyword>
    <keyword>Chat</keyword>
    <keyword>Voice</keyword>
    <keyword>Push-to-talk</keyword>
  </keywords>

  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <branding>
    <color type="primary" scheme_preference="light">#2d5be3</color>
    <color type="primary" scheme_preference="dark">#2d5be3</color>
  </branding>

  <!-- Chat with strangers, uncontrolled: OARS "intense" for social chat. -->
  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>

  <releases>
    <release version="0.1.0" date="2026-10-14" type="development">
      <description>
        <p>First packaged version.</p>
      </description>
    </release>
  </releases>
</component>

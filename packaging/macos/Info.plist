<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged by cargo-packager over the Info.plist it generates
     (scripts/package.sh). macOS shows the usage descriptions in its
     microphone and camera prompts, and ends an app that opens either without
     one. Screen recording has no key: macOS asks on its own. -->
<plist version="1.0">
<dict>
    <key>NSMicrophoneUsageDescription</key>
    <string>Twicecat uses the microphone for calls and the microphone test.</string>
    <key>NSCameraUsageDescription</key>
    <string>Twicecat uses the camera for video in calls and its preview in Settings.</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.social-networking</string>
</dict>
</plist>

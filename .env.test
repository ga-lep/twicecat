# Localhost-only throwaway values for the local Docker Synapse (docker-compose.yml).
# NEVER put real credentials or real account names in this file.
HOMESERVER_DOMAIN=localhost
TEST_USER_1=alice
TEST_PASSWORD_1=alice-throwaway-pw-1
TEST_USER_2=bob
TEST_PASSWORD_2=bob-throwaway-pw-2
TEST_USER_3=carol
TEST_PASSWORD_3=carol-throwaway-pw-3
# Local LiveKit SFU and lk-jwt-service (docker-compose.yml); test-only values.
LIVEKIT_KEY=devkey
LIVEKIT_SECRET=bc65f518fb98aca1c996048e9b2e5d25bc18b8a24d38bcb3
# Where the local stack listens (scripts/stack.sh). Change them for this
# machine in .env.local (not committed; same KEY=VALUE lines), or for one run
# in the environment, which wins over both. The URLs the clients use
# (HOMESERVER_URL, LK_JWT_URL, LIVEKIT_URL, and _B) are derived from these.
# The tests accept only 127.0.0.1 or ::1 (AGENTS.md rule 6); ::1 is untested.
TESSERA_ADDRESS=127.0.0.1
TESSERA_SYNAPSE_PORT=8008
TESSERA_LK_JWT_PORT=8080
TESSERA_LIVEKIT_PORT=7880
TESSERA_LIVEKIT_TCP_PORT=7881
TESSERA_LIVEKIT_UDP_PORT=7882
# Second call service (multi-SFU tests).
TESSERA_LK_JWT_PORT_B=8081
TESSERA_LIVEKIT_PORT_B=7890
TESSERA_LIVEKIT_TCP_PORT_B=7891
TESSERA_LIVEKIT_UDP_PORT_B=7892
